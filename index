<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>透過PNGにグラデーションを合成</title>
  <style>
    body {
      font-family: sans-serif;
      margin: 2em;
      background: #f0f0f0;
    }
    canvas {
      margin: 10px 0;
      border: 1px solid #ccc;
      background: transparent;
    }
    .image-container {
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <h2>PNGにグラデーションを重ねてZIPで保存</h2>
  <input type="file" id="upload" accept="image/png" multiple><br><br>

  <label>開始色: <input type="color" id="startColor" value="#ff0000"></label>
  <label>終了色: <input type="color" id="endColor" value="#0000ff"></label><br><br>

  <label>不透明度（0〜100）: <input type="range" id="opacity" min="0" max="100" value="80"></label><br><br>

  <label>方向:
    <select id="direction">
      <option value="vertical">縦</option>
      <option value="horizontal">横</option>
      <option value="diagonal1">斜め ↘</option>
      <option value="diagonal2">斜め ↙</option>
    </select>
  </label>
  <br><br>
  <button onclick="processImages()">画像を処理してZIPで保存</button>

  <div id="preview"></div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.0/jszip.min.js"></script>
  <script>
    async function processImages() {
      const files = document.getElementById('upload').files;
      const startColor = document.getElementById('startColor').value;
      const endColor = document.getElementById('endColor').value;
      const direction = document.getElementById('direction').value;
      const opacity = parseInt(document.getElementById('opacity').value) / 100;
      const preview = document.getElementById('preview');
      preview.innerHTML = '';

      const zip = new JSZip();

      for (const file of files) {
        const img = await loadImage(file);
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d');

        canvas.width = img.width;
        canvas.height = img.height;

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.drawImage(img, 0, 0);

        let grad;
        switch (direction) {
          case 'horizontal':
            grad = ctx.createLinearGradient(0, 0, canvas.width, 0);
            break;
          case 'diagonal1':
            grad = ctx.createLinearGradient(0, 0, canvas.width, canvas.height);
            break;
          case 'diagonal2':
            grad = ctx.createLinearGradient(canvas.width, 0, 0, canvas.height);
            break;
          default:
            grad = ctx.createLinearGradient(0, 0, 0, canvas.height);
        }

        const rgbaStart = hexToRgba(startColor, opacity);
        const rgbaEnd = hexToRgba(endColor, opacity);
        grad.addColorStop(0, rgbaStart);
        grad.addColorStop(1, rgbaEnd);

        ctx.globalCompositeOperation = 'source-atop';
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.globalCompositeOperation = 'source-over';

        const dataUrl = canvas.toDataURL('image/png');
        const imgData = await (await fetch(dataUrl)).blob();

        const newFileName = file.name.replace(/(\d+x\d+)/, 'grad');
        zip.file(newFileName, imgData);

        const container = document.createElement('div');
        container.className = 'image-container';
        container.appendChild(canvas);
        preview.appendChild(container);
      }

      zip.generateAsync({ type: "blob" }).then(function(content) {
        const link = document.createElement('a');
        link.href = URL.createObjectURL(content);
        link.download = 'processed_images.zip';
        link.click();
      });
    }

    function loadImage(file) {
      return new Promise((resolve) => {
        const reader = new FileReader();
        reader.onload = () => {
          const img = new Image();
          img.onload = () => resolve(img);
          img.src = reader.result;
        };
        reader.readAsDataURL(file);
      });
    }

    function hexToRgba(hex, alpha) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `rgba(${r}, ${g}, ${b}, ${alpha})`;
    }
  </script>
</body>
</html>
